# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# OpenAI (required for proposal generation)
OPENAI_API_KEY=sk-...

# Public site URL — used in collaboration invite links (production: your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — optional; invitations fall back to logging link without this
RESEND_API_KEY=re_...
# Verified domain sender (recommended for production)
# RESEND_FROM_EMAIL=noreply@yourdomain.com
