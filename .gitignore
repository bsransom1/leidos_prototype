# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep tracked template only
.env*
!.env.example

# vercel
.vercel

# Cursor / agent workspace state
.cursor/
.agents/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local CLI cache
supabase/.temp/

# Large demo PDFs in public/baas (JSON org-context fixtures may be tracked)
public/baas/*.pdf

# Local org-context fixture (may contain demo PII — do not commit)
org_context.json
